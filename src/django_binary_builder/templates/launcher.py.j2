"""Application entry point generated by django-binary-builder.

Do not edit this file; regenerate it with the ``binary`` management
command instead.

The script runs inside the bundled portable Python runtime: it
serves the Django application with waitress on a loopback port in a
background thread and presents it through a pywebview window (with a
browser fallback). On Windows it also brands the window and the
taskbar with the application icon.
"""

import logging
import os
import shutil
import socket
import sys
import threading
import time
import traceback
import webbrowser
from importlib import import_module
from pathlib import Path
from urllib.parse import urlsplit

APP_NAME = {{ app_name | tojson }}
PUBLISHER = {{ publisher | tojson }}
SETTINGS_MODULE = {{ settings_module | tojson }}
WSGI_APPLICATION = {{ wsgi_application | tojson }}
APP_ICON = {{ (icon_path or "") | tojson }}

ENVIRONMENT_FILENAME = ".env"
DATA_DIR_ENVIRONMENT_VARIABLE = "DJANGO_BINARY_DATA_DIR"
ADMIN_USERNAME_ENVIRONMENT_VARIABLE = "DJANGO_BINARY_ADMIN_USERNAME"
ADMIN_PASSWORD_ENVIRONMENT_VARIABLE = "DJANGO_BINARY_ADMIN_PASSWORD"

DEFAULT_ADMIN_USERNAME = "admin"
DEFAULT_ADMIN_PASSWORD = "admin1234"
DEFAULT_ADMIN_EMAIL = "admin@localhost"

DEFAULT_HOST = "127.0.0.1"
PREFERRED_PORT = 8765
SERVER_THREADS = 8
WINDOW_WIDTH = 1200
WINDOW_HEIGHT = 800

LOG_FORMAT = "%(asctime)s %(levelname)s %(message)s"

LOGGER_NAME = "django_binary_builder_app"

# Windows window-icon plumbing. The executable icon only brands the
# .exe file itself; the title bar and the taskbar take their icon from
# the window at runtime, so it has to be applied explicitly.
IMAGE_ICON = 1
LR_LOADFROMFILE = 0x00000010
GW_OWNER = 4
WM_SETICON = 0x0080
ICON_SMALL = 0
ICON_BIG = 1
SM_CXICON = 11
SM_CXSMICON = 49
WINDOW_HANDLE_TIMEOUT = 60.0
WINDOW_HANDLE_POLL_INTERVAL = 0.25


def main() -> int:
    app_dir = Path(__file__).resolve().parent
    data_root = resolve_data_root()
    directories = prepare_directories(data_root)

    redirect_stdio(directories["logs"])

    logger = configure_logging(directories["logs"])

    logger.info("Starting %s ...", APP_NAME)

    try:
        return run(app_dir, directories, logger)
    except Exception:
        logger.error("The application failed to start:\n%s", traceback.format_exc())
        return 1


def run(app_dir: Path, directories: dict, logger: logging.Logger) -> int:
    load_environment_file(app_dir / ENVIRONMENT_FILENAME, logger)

    os.environ.setdefault("DJANGO_SETTINGS_MODULE", SETTINGS_MODULE)

    if str(app_dir) not in sys.path:
        sys.path.insert(0, str(app_dir))

    import django

    django.setup()

    configure_allowed_hosts()
    configure_database(directories["data"], app_dir, logger)
    run_migrations(logger)
    ensure_initial_admin(logger)

    application = load_wsgi_application()
    application = wrap_static_files(application, app_dir, directories["media"], logger)

    port = find_available_port(DEFAULT_HOST, PREFERRED_PORT)
    url = "http://%s:%d/" % (DEFAULT_HOST, port)

    logger.info("Serving the application at %s", url)

    from waitress.server import create_server

    server = create_server(
        application,
        host=DEFAULT_HOST,
        port=port,
        threads=SERVER_THREADS,
    )

    server_thread = threading.Thread(target=server.run, daemon=True)
    server_thread.start()

    return present_window(url, app_dir, logger, server, server_thread)


# ---------------------------------------------------------------------------
# Environment and directories


def safe_directory_name(value: str) -> str:
    characters = []

    for character in str(value).strip():
        if character.isalnum() or character in {"-", "_"}:
            characters.append(character)
        else:
            characters.append("-")

    normalized = "".join(characters).strip("-")

    while "--" in normalized:
        normalized = normalized.replace("--", "-")

    return normalized or "DjangoBinaryBuilder"


def resolve_data_root() -> Path:
    override = os.environ.get(DATA_DIR_ENVIRONMENT_VARIABLE)

    if override:
        return Path(override).expanduser().resolve()

    company = safe_directory_name(PUBLISHER)
    application = safe_directory_name(APP_NAME)

    local_app_data = os.environ.get("LOCALAPPDATA")

    if local_app_data:
        return (Path(local_app_data) / company / application).resolve()

    return (Path.home() / ".local" / "share" / company / application).resolve()


def prepare_directories(data_root: Path) -> dict:
    directories = {
        "data": data_root / "data",
        "logs": data_root / "logs",
        "media": data_root / "media",
    }

    for directory in directories.values():
        directory.mkdir(parents=True, exist_ok=True)

    return directories


def redirect_stdio(logs_dir: Path) -> None:
    """Keep output visible when running under pythonw (no console)."""

    if sys.stdout is not None and sys.stderr is not None:
        return

    stream = open(logs_dir / "startup.log", "a", encoding="utf-8", buffering=1)

    sys.stdout = sys.stdout or stream
    sys.stderr = sys.stderr or stream


def configure_logging(logs_dir: Path) -> logging.Logger:
    logger = logging.getLogger(LOGGER_NAME)
    logger.setLevel(logging.INFO)

    if logger.handlers:
        return logger

    formatter = logging.Formatter(LOG_FORMAT)

    file_handler = logging.FileHandler(
        logs_dir / "application.log",
        encoding="utf-8",
    )
    file_handler.setFormatter(formatter)
    logger.addHandler(file_handler)

    if sys.stdout is not None:
        console_handler = logging.StreamHandler()
        console_handler.setFormatter(formatter)
        logger.addHandler(console_handler)

    return logger


def load_environment_file(path: Path, logger: logging.Logger) -> None:
    """Apply the bundled ``.env``; the process environment always wins."""

    if not path.is_file():
        return

    try:
        from dotenv import dotenv_values
    except ImportError:
        logger.warning(
            "python-dotenv is not installed; skipped %s.",
            path.name,
        )
        return

    for name, value in dotenv_values(path).items():
        if value is None:
            continue

        if name not in os.environ:
            os.environ[name] = value
        elif os.environ[name] != value:
            logger.info(
                "Environment variable %s is overridden by the process.",
                name,
            )


# ---------------------------------------------------------------------------
# Django bootstrap


def configure_allowed_hosts() -> None:
    from django.conf import settings as django_settings

    allowed_hosts = list(django_settings.ALLOWED_HOSTS)

    for host in (DEFAULT_HOST, "localhost"):
        if host not in allowed_hosts:
            allowed_hosts.append(host)

    django_settings.ALLOWED_HOSTS = allowed_hosts


def configure_database(
    data_dir: Path,
    app_dir: Path,
    logger: logging.Logger,
) -> None:
    """Move the default SQLite database into the writable data directory.

    On first start the database is seeded from the copy bundled with
    the application, when present. An existing user database is never
    overwritten.
    """

    from django.conf import settings as django_settings

    database = django_settings.DATABASES.get("default")

    if not database:
        return

    engine = str(database.get("ENGINE") or "")

    if "sqlite" not in engine:
        return

    name = database.get("NAME")

    if name is None or str(name) == ":memory:":
        return

    source = Path(str(name))

    if not source.is_absolute():
        source = app_dir / source

    target = data_dir / (source.name or "db.sqlite3")

    if not target.exists():
        target.parent.mkdir(parents=True, exist_ok=True)

        if source.is_file():
            shutil.copy2(source, target)

            logger.info(
                "Seeded the application database from the bundled %s.",
                source.name,
            )

    database["NAME"] = str(target)


def run_migrations(logger: logging.Logger) -> None:
    from django.core.management import call_command

    logger.info("Applying database migrations...")

    call_command("migrate", interactive=False, verbosity=0)


def ensure_initial_admin(logger: logging.Logger) -> None:
    """Create an initial superuser on first start, if none exists."""

    from django.conf import settings as django_settings

    if "django.contrib.auth" not in django_settings.INSTALLED_APPS:
        return

    from django.contrib.auth import get_user_model

    user_model = get_user_model()

    if user_model.objects.filter(is_superuser=True).exists():
        return

    username = (
        os.environ.get(ADMIN_USERNAME_ENVIRONMENT_VARIABLE) or DEFAULT_ADMIN_USERNAME
    )
    password = (
        os.environ.get(ADMIN_PASSWORD_ENVIRONMENT_VARIABLE) or DEFAULT_ADMIN_PASSWORD
    )

    field_values = {user_model.USERNAME_FIELD: username}
    email_field = getattr(user_model, "EMAIL_FIELD", "email")

    if email_field and hasattr(user_model, email_field):
        field_values[email_field] = DEFAULT_ADMIN_EMAIL

    user_model.objects.create_superuser(password=password, **field_values)

    logger.warning(
        "Created the initial administrator %r with the default password; "
        "change it after the first login.",
        username,
    )


def load_wsgi_application():
    from django.conf import settings as django_settings

    reference = WSGI_APPLICATION or django_settings.WSGI_APPLICATION

    if not reference:
        raise RuntimeError(
            "WSGI_APPLICATION is not configured in the Django settings."
        )

    module_name, _, attribute = str(reference).rpartition(".")

    if not module_name:
        raise RuntimeError(f"Invalid WSGI application reference: {reference}")

    module = import_module(module_name)

    return getattr(module, attribute or "application")


# ---------------------------------------------------------------------------
# Static and media file serving


def wrap_static_files(
    application,
    app_dir: Path,
    media_dir: Path,
    logger: logging.Logger,
):
    """Serve collected static files and media without a web server."""

    from django.conf import settings as django_settings

    mounts = []

    static_url = getattr(django_settings, "STATIC_URL", None)

    if static_url and "django.contrib.staticfiles" in django_settings.INSTALLED_APPS:
        _append_mount(
            mounts,
            url_path_prefix(static_url),
            app_dir / "staticfiles",
        )

    media_url = getattr(django_settings, "MEDIA_URL", None)

    if media_url:
        _append_mount(mounts, url_path_prefix(media_url), media_dir)

    if not mounts:
        return application

    logger.info(
        "Serving static files at %s",
        ", ".join(prefix for prefix, _ in mounts),
    )

    def wrapped(environ, start_response):
        path_info = environ.get("PATH_INFO", "")

        for prefix, root in mounts:
            if path_info.startswith(prefix):
                return serve_static_file(
                    root,
                    path_info[len(prefix):],
                    start_response,
                )

        return application(environ, start_response)

    return wrapped


def _append_mount(mounts: list, prefix: str, root: Path) -> None:
    """Register a file mount unless it would swallow every route.

    Django 6.1 defaults ``MEDIA_URL`` to ``/``, and a file handler
    mounted at ``/`` would shadow the whole application.
    """

    if prefix == "/":
        return

    mounts.append((prefix, root))


def url_path_prefix(url: str) -> str:
    path = urlsplit(str(url)).path

    if not path.startswith("/"):
        path = "/" + path

    if not path.endswith("/"):
        path += "/"

    return path


def serve_static_file(root: Path, relative: str, start_response):
    import mimetypes
    from wsgiref.util import FileWrapper

    candidate = (root / relative.lstrip("/")).resolve()
    root_resolved = root.resolve()

    if candidate != root_resolved and root_resolved not in candidate.parents:
        start_response("403 Forbidden", [("Content-Type", "text/plain")])
        return [b"Forbidden"]

    if not candidate.is_file():
        start_response("404 Not Found", [("Content-Type", "text/plain")])
        return [b"Not found"]

    content_type = (
        mimetypes.guess_type(str(candidate))[0] or "application/octet-stream"
    )

    start_response(
        "200 OK",
        [
            ("Content-Type", content_type),
            ("Content-Length", str(candidate.stat().st_size)),
            ("Cache-Control", "no-cache"),
        ],
    )

    return FileWrapper(open(candidate, "rb"))


# ---------------------------------------------------------------------------
# Server and window


def find_available_port(host: str, preferred_port: int) -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        try:
            probe.bind((host, preferred_port))
        except OSError:
            probe.bind((host, 0))
            return int(probe.getsockname()[1])

        return preferred_port


def present_window(
    url: str,
    app_dir: Path,
    logger: logging.Logger,
    server,
    server_thread,
) -> int:
    """Open the application window; fall back to the default browser."""

    window_shown = False

    configure_windows_taskbar_identity(logger)
    icon_path = resolve_app_icon(app_dir)

    try:
        import webview

        window = webview.create_window(
            APP_NAME,
            url,
            width=WINDOW_WIDTH,
            height=WINDOW_HEIGHT,
        )

        brand_window(icon_path, logger)

        webview.start()

        window_shown = True
    except ImportError:
        logger.warning(
            "pywebview is not installed; opening the default browser instead."
        )
    except Exception:
        logger.warning(
            "The application window could not be opened; opening the "
            "default browser instead:\n%s",
            traceback.format_exc(),
        )

    if window_shown:
        logger.info("The application window was closed; shutting down.")

        server.close()

        return 0

    webbrowser.open(url)

    server_thread.join()

    return 0


# ---------------------------------------------------------------------------
# Window and taskbar branding


def resolve_app_icon(app_dir: Path) -> Path | None:
    """Locate the bundled icon used to brand the application window."""

    if not APP_ICON:
        return None

    icon_path = (app_dir / APP_ICON).resolve()

    return icon_path if icon_path.is_file() else None


def configure_windows_taskbar_identity(logger: logging.Logger) -> None:
    """Register an explicit Windows AppUserModelID for this process.

    Without it Windows associates the taskbar button with the generic
    Python interpreter instead of this application, which keeps the
    default interpreter icon on the taskbar and breaks pinning.
    """

    if sys.platform != "win32":
        return

    try:
        import ctypes

        application_identity = (
            f"{safe_directory_name(PUBLISHER)}.{safe_directory_name(APP_NAME)}"
        )

        ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(
            application_identity
        )
    except Exception:
        logger.warning(
            "The Windows taskbar identity could not be set:\n%s",
            traceback.format_exc(),
        )


def brand_window(icon_path: Path | None, logger: logging.Logger) -> None:
    """Apply the application icon to the window once it exists.

    The window is created by the GUI event loop on a separate thread,
    so the icon is applied from a background worker that waits for the
    window handle to appear.
    """

    if icon_path is None or sys.platform != "win32":
        return

    threading.Thread(
        target=_apply_window_icon,
        args=(icon_path, logger),
        daemon=True,
    ).start()


def _apply_window_icon(icon_path: Path, logger: logging.Logger) -> None:
    try:
        handle = _wait_for_window_handle()

        if not handle:
            logger.warning(
                "The application window was not found in time; the "
                "window icon was not applied."
            )
            return

        _send_window_icon(handle, icon_path)

        logger.info("Applied the application icon to the window.")
    except Exception:
        logger.warning(
            "The application icon could not be applied:\n%s",
            traceback.format_exc(),
        )


def _wait_for_window_handle() -> int:
    """Poll for the process's visible top-level application window."""

    import ctypes
    from ctypes import wintypes

    user32 = ctypes.windll.user32

    enum_procedure = ctypes.WINFUNCTYPE(
        wintypes.BOOL,
        wintypes.HWND,
        wintypes.LPARAM,
    )

    process_id = os.getpid()

    deadline = time.monotonic() + WINDOW_HANDLE_TIMEOUT

    while time.monotonic() < deadline:
        candidates: list[int] = []

        def visit(handle, _parameter):
            if _is_top_level_process_window(user32, handle, process_id):
                candidates.append(handle)

            return True

        user32.EnumWindows(enum_procedure(visit), 0)

        for handle in candidates:
            if _window_title(user32, handle) == APP_NAME:
                return handle

        if len(candidates) == 1:
            return candidates[0]

        time.sleep(WINDOW_HANDLE_POLL_INTERVAL)

    return 0


def _is_top_level_process_window(user32, handle: int, process_id: int) -> bool:
    import ctypes
    from ctypes import wintypes

    if not user32.IsWindowVisible(handle):
        return False

    if user32.GetWindow(handle, GW_OWNER):
        return False

    owner_process = wintypes.DWORD()

    user32.GetWindowThreadProcessId(handle, ctypes.byref(owner_process))

    return owner_process.value == process_id


def _window_title(user32, handle: int) -> str:
    import ctypes

    length = user32.GetWindowTextLengthW(handle)

    buffer = ctypes.create_unicode_buffer(length + 1)

    user32.GetWindowTextW(handle, buffer, length + 1)

    return buffer.value


def _send_window_icon(handle: int, icon_path: Path) -> None:
    """Set the window icon for the title bar and the taskbar button."""

    import ctypes
    from ctypes import wintypes

    user32 = ctypes.windll.user32

    user32.LoadImageW.restype = wintypes.HANDLE
    user32.LoadImageW.argtypes = [
        wintypes.HANDLE,
        wintypes.LPCWSTR,
        wintypes.UINT,
        ctypes.c_int,
        ctypes.c_int,
        wintypes.UINT,
    ]
    user32.SendMessageW.argtypes = [
        wintypes.HWND,
        wintypes.UINT,
        wintypes.WPARAM,
        wintypes.LPARAM,
    ]

    large_size = user32.GetSystemMetrics(SM_CXICON) or 32
    small_size = user32.GetSystemMetrics(SM_CXSMICON) or 16

    large_icon = _load_icon(user32, icon_path, large_size)
    small_icon = _load_icon(user32, icon_path, small_size)

    if large_icon:
        user32.SendMessageW(handle, WM_SETICON, ICON_BIG, large_icon)

    if small_icon:
        user32.SendMessageW(handle, WM_SETICON, ICON_SMALL, small_icon)


def _load_icon(user32, icon_path: Path, size: int) -> int:
    return user32.LoadImageW(
        None,
        str(icon_path),
        IMAGE_ICON,
        size,
        size,
        LR_LOADFROMFILE,
    )


if __name__ == "__main__":
    sys.exit(main())
