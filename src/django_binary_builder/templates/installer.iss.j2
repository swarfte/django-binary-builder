; Inno Setup script generated by django-binary-builder. Do not edit.

#define MyAppName "{{ app_name }}"
#define MyAppVersion "{{ app_version }}"
#define MyAppPublisher "{{ publisher }}"
#define MyAppExeName "{{ executable_name }}.exe"

[Setup]
AppId={% raw %}{{{% endraw %}{{ app_id[1:-1] }}{% raw %}}}{% endraw %}
AppName={% raw %}{#MyAppName}{% endraw %}
AppVersion={% raw %}{#MyAppVersion}{% endraw %}
AppPublisher={% raw %}{#MyAppPublisher}{% endraw %}
DefaultDirName={localappdata}\Programs\{% raw %}{#MyAppName}{% endraw %}
DefaultGroupName={% raw %}{#MyAppName}{% endraw %}
OutputDir="{{ release_dir }}"
OutputBaseFilename={{ installer_filename }}
Compression=lzma2
SolidCompression=yes
PrivilegesRequired={{ privileges }}
WizardStyle=modern
ArchitecturesAllowed={{ architecture }}
UninstallDisplayName={% raw %}{#MyAppName}{% endraw %}
{% if icon %}
SetupIconFile="{{ icon }}"
{% endif %}

[Files]
Source: "{{ bundle_dir }}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
{% if create_start_menu_shortcut %}
Name: "{group}\{% raw %}{#MyAppName}{% endraw %}"; Filename: "{app}\{% raw %}{#MyAppExeName}{% endraw %}"
{% endif %}
{% if create_desktop_shortcut %}
Name: "{autodesktop}\{% raw %}{#MyAppName}{% endraw %}"; Filename: "{app}\{% raw %}{#MyAppExeName}{% endraw %}"
{% endif %}

[Run]
Filename: "{app}\{% raw %}{#MyAppExeName}{% endraw %}"; Description: "Launch {% raw %}{#MyAppName}{% endraw %}"; Flags: nowait postinstall skipifsilent
